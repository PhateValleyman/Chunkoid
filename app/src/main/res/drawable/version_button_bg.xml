<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_surfaceContainerHighest" />
            <stroke android:color="@color/md_theme_primary" android:width="1.5dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_surfaceContainer" />
            <stroke android:color="@color/md_theme_outlineVariant" android:width="1dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>