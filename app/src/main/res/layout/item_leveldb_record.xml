<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="3dp"
    app:cardBackgroundColor="@color/card_subtle_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_subtle_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <View
            android:id="@+id/v_category_indicator"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_handle_bar"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_record_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Místní hráč-hostitel (~local_player)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_record_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Velikost: 1.4 KB | Klíč: ~local_player"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_nbt_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NBT"
                android:textSize="10sp"
                android:textColor="?attr/colorPrimary"
                app:chipCornerRadius="10dp"
                app:chipMinHeight="24dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hráč"
                android:textSize="10sp"
                app:chipCornerRadius="10dp"
                app:chipMinHeight="24dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
