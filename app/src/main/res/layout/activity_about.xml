<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false"
    android:importantForAutofill="noExcludeDescendants">

    <ImageView
        android:id="@+id/iv_custom_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/v_custom_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/about"
                app:titleTextColor="?attr/colorOnSurface"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:navigationIconTint="?attr/colorOnSurface" />

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="20dp"
                    android:gravity="center">

                    <FrameLayout
                        android:id="@+id/fl_app_logo"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_squircle_icon">

                        <ImageView
                            android:id="@+id/iv_app_logo"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_app_logo"
                            android:contentDescription="@string/about_logo_desc"
                            app:tint="?attr/colorPrimary" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tv_app_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_version"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_badge_tag" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_subtle_bg"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_subtle_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="18dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_author_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_developer_maintainer"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_original_author"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/fl_social_author"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_squircle_icon"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/iv_author"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/about_author_desc"
                                    android:src="@drawable/author"
                                    app:tint="?attr/colorPrimary" />

                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/fl_social_bilibili"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_squircle_icon"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/iv_bilibili"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Bilibili"
                                    android:src="@drawable/bilibili"
                                    app:tint="?attr/colorPrimary" />

                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/fl_social_github"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_squircle_icon"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/iv_github"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="GitHub"
                                    android:src="@drawable/github"
                                    app:tint="?attr/colorPrimary" />

                            </FrameLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_subtle_bg"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_subtle_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="24dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_intro"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:lineSpacingMultiplier="1.35" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/card_subtle_stroke" />

                        <TextView
                            android:id="@+id/tv_chunker_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_credits_chunker"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:lineSpacingMultiplier="1.3" />

                        <TextView
                            android:id="@+id/tv_nbt_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_credits_nbt"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tv_leveldb_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_credits_leveldb"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tv_sdk_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_credits_sdk"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tv_thanks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_thanks"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp">

                            <TextView
                                android:id="@+id/tv_website_link"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_website"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:paddingEnd="16dp" />

                            <TextView
                                android:id="@+id/tv_docs_link"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_docs"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_date"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:layout_marginTop="14dp"
                            android:gravity="end" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_update"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/check_update"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="27dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_donate"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/donate"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorSecondaryContainer"
                app:cornerRadius="27dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
