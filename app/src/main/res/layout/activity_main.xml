<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false">

        <!-- Full-Screen Custom Wallpaper Layer (Zero flicker, zero black screen) -->
        <ImageView
            android:id="@+id/iv_custom_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Dim Scrim Layer -->
        <View
            android:id="@+id/v_custom_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000"
            android:visibility="gone" />

        <!-- Main Scrollable Workbench Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_workbench"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingTop="36dp"
            android:paddingBottom="160dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- Top Workbench Headline -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/converter_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Menu / Quick Drawer Button (Icon Only) -->
                    <ImageView
                        android:id="@+id/btn_menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_menu"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Menu"
                        app:tint="?attr/colorOnSurface" />

                </LinearLayout>

                <!-- Top Segmented Pill Switcher -->
                <!-- Hero File Dropzone Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hero_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/hero_card_background"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_subtle_stroke"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <!-- 1. Initial State: Large 72dp Circle + Text + Tag Chips -->
                        <LinearLayout
                            android:id="@+id/card_initial_state"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <!-- Centered 72dp Circular Plus Button -->
                            <FrameLayout
                                android:id="@+id/btn_hero_circle"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_circle_button">

                                <ImageView
                                    android:id="@+id/iv_hero_plus"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_add"
                                    app:tint="@color/hero_icon_tint" />

                            </FrameLayout>

                            <!-- Headline & Subtitle -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="导入 Minecraft 世界文件"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="支持 .zip / .mcworld / 文件夹 (Bedrock &amp; Java)"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />



                        </LinearLayout>

                        <!-- 2. Extracting State: Smooth ProgressBar & Status Message -->
                        <LinearLayout
                            android:id="@+id/layout_extract_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="16dp"
                            android:visibility="gone"
                            tools:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progress_extract"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_drawable" />

                            <TextView
                                android:id="@+id/tv_extract_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="正在读取并解析世界文件..."
                                android:textColor="?attr/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- 3. Loaded State: World Info Card -->
                        <LinearLayout
                            android:id="@+id/card_world_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:visibility="gone"
                            tools:visibility="gone">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_world_icon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_marginEnd="14dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/unknown"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.MD3E.Squircle"
                                app:strokeColor="@color/card_subtle_stroke"
                                app:strokeWidth="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_world_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="我的世界"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <LinearLayout
                                    android:id="@+id/card_platform"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_platform"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_badge_tag"
                                        android:text="基岩版 (Bedrock)"
                                        android:textColor="?attr/colorPrimary"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:layout_marginEnd="6dp" />

                                    <TextView
                                        android:id="@+id/tv_version"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_badge_tag"
                                        android:text="1.20.80"
                                        android:textColor="?attr/colorPrimary"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                            </LinearLayout>

                            <FrameLayout
                                android:id="@+id/btn_clear_world"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_squircle_icon"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_close"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                            </FrameLayout>

                        </LinearLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>



                <!-- Config Card 1: Target Version & Platform Tile (Single-Layer Interactive Card) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_select_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_subtle_bg"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_subtle_stroke"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="18dp">

                        <FrameLayout
                            android:id="@+id/fl_main_earth"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_squircle_icon">

                            <ImageView
                                android:id="@+id/iv_main_earth"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_world"
                                app:tint="?attr/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="目标版本与格式"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_target_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="点击选择目标平台与版本"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Primary Action Button (Integrated into Main Workflow) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dock_action"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:text="开始转换"
                    app:icon="@drawable/ic_bolt"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="27dp"
                    app:elevation="0dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Fragment Container for History & Secondary Pages -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Clean Material 3 Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?attr/colorSurfaceContainer"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:elevation="8dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer -->
    <include
        android:id="@+id/nav_drawer"
        layout="@layout/nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
