    <string name="settings_title">设置</string>
    <string name="performance_settings">性能与优化</string>
    <string name="wake_lock">后台唤醒锁 (WakeLock)</string>
    <string name="wake_lock_desc">在转换期间保持 CPU 活跃，防止手机息屏或切后台时转换被系统休眠、降频或杀后台</string>
    <string name="low_memory_mode">低运存防闪退</string>
    <string name="low_memory_mode_desc">限制多线程并发并激进回收内存。有效防止OOM闪退，但会降低转换速度</string>
    <string name="dimension_pruning">维度裁剪与映射</string>
    <string name="dimension_pruning_desc">配置是否保留下界与末地，裁剪无效维度可大幅缩减耗时与内存</string>
    <string name="conversion_settings">转换设置</string>
    <string name="jvm_max_memory">JVM最大内存（MB）</string>
    <string name="memory_hint">要转换大存档（超1GB）时，根据手机性能增加最大内存，提升转换速率；最大内存过小，转换时则容易报错</string>
    <string name="keep_original_nbt">保留原始NBT</string>
    <string name="keep_original_nbt_desc">保留原始存档物品栏数据，在相同平台转换时建议启用</string>
    <string name="general_settings">通用</string>
    <string name="theme_switch">外观与深色模式</string>
    <string name="theme_system">跟随系统</string>
    <string name="theme_system_desc">根据系统设置自动切换浅色或深色</string>
    <string name="theme_light">浅色模式</string>
    <string name="theme_light_desc">始终使用明亮的浅色主题</string>
    <string name="theme_dark">深色模式</string>
    <string name="theme_dark_desc">始终使用沉浸的深色主题</string>
    <string name="dynamic_color">动态取色 (Material You)</string>
