<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/performance_settings">

        <SeekBarPreference
            android:key="max_memory"
            android:title="@string/jvm_max_memory"
            android:defaultValue="4096"
            android:max="16384"
            app:min="512"
            app:seekBarIncrement="256"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="enable_wake_lock"
            android:title="@string/wake_lock"
            android:summary="@string/wake_lock_desc"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="low_memory_mode"
            android:title="@string/low_memory_mode"
            android:summary="@string/low_memory_mode_desc"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/conversion_settings">

        <SwitchPreferenceCompat
            android:key="keep_original_nbt"
            android:title="@string/keep_original_nbt"
            android:summary="@string/keep_original_nbt_desc"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
